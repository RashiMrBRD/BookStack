# iotdocs/.env — compose substitution variables only.
# Copy to iotdocs/.env on the server. Runtime secrets live in ../.env instead
# (see runtime.env.example) — matching the iotadmin split convention.

DOCS_DOMAIN=docs.iotlab-uphsdm.live

# Host path for persistent data, relative to this compose directory.
# ../.. lands at /media/projects on the target host — outside the synced tree.
BOOKSTACK_DATA_PATH=../../data/bookstack
