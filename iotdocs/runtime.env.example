# ../.env (bookstack repo root on the server) — container runtime env.
# Copy to ../.env and fill in generated secrets. NEVER commit this file.

APP_NAME="IoTLab Docs"
APP_URL=https://docs.iotlab-uphsdm.live
APP_THEME=iotlab

# Generate: openssl rand -base64 32  →  APP_KEY=base64:<output>
APP_KEY=base64:GENERATE_ME

# App-side DB credentials (DB_HOST is the unique compose service name)
DB_HOST=bookstack-db
DB_DATABASE=bookstack
DB_USERNAME=bookstack
DB_PASSWORD=GENERATE_ME

# MariaDB image bootstrap vars — MYSQL_PASSWORD must equal DB_PASSWORD
MYSQL_DATABASE=bookstack
MYSQL_USER=bookstack
MYSQL_PASSWORD=SAME_AS_DB_PASSWORD
MYSQL_ROOT_PASSWORD=GENERATE_ME

STORAGE_TYPE=local
MAIL_DRIVER=smtp
MAIL_FROM_NAME="IoTLab Docs"
